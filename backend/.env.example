NODE_ENV=development
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000
SESSION_DRIVER=cookie

DB_HOST=localhost
DB_PORT=5432
DB_USER=matchpa
DB_PASSWORD=matchpa
DB_DATABASE=matchpa

# true: activa las rutas de Google. Debe coincidir con NEXT_PUBLIC_GOOGLE_AUTH_ENABLED del frontend
GOOGLE_AUTH_ENABLED=false
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe estar en los URI de redirección autorizados. En producción: https://matchpa.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3333/api/auth/google/callback

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@matchpa.app
LIMITER_STORE=database
ADMIN_EMAIL=hola@matchpa.app
MAIL_MAILER=smtp
MAIL_FROM="MatchPa <no-reply@matchpa.app>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
